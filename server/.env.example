# Server Port (Render sets this automatically, default: 5000)
PORT=5000

# MongoDB Atlas Connection String (Render Environment Variable)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/balaji-tent-house?retryWrites=true&w=majority

# Initial Admin Account Settings (used for initial auto-bootstrap)
ADMIN_NAME=Yamuna Shankar Bairagi
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NUMBER=+919783950350

# JWT Authentication
JWT_SECRET=generate-a-long-random-secret-string-here
JWT_EXPIRES_IN=7d
COOKIE_NAME=btk_token

# Frontend Vercel App URL (e.g. https://your-project.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app
